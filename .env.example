# --- Neo4j ---
NEO4J_AUTH=neo4j/km_dev_password

# --- PostgreSQL ---
POSTGRES_USER=km
POSTGRES_PASSWORD=km_dev_password
POSTGRES_DB=km_engine
# --- Connettivita app (dev) ---
KM_NEO4J_URI=bolt://localhost:7687
KM_NEO4J_USER=neo4j
KM_NEO4J_PASSWORD=km_dev_password
KM_PG_DSN=postgresql://km:km_dev_password@localhost:5432/km_engine
KM_JWT_SECRET=dev-only-secret-0123456789abcdef-0123456789abcdef
# Bootstrap admin al primo avvio
KM_ADMIN_USERNAME=admin
KM_ADMIN_PASSWORD=adm1n-dev-pass

# ---------------------------------------------------------------------------
# LLM di traduzione e giudizio (WP-F6).
# Qualunque endpoint OpenAI-compatibile. Con Ollama locale l'API key non serve:
# il client manda l'header Authorization solo se KM_LLM_API_KEY e' valorizzata.
#   ollama pull deepseek-v4-flash:cloud
# ---------------------------------------------------------------------------
KM_LLM_ENDPOINT=http://localhost:11434/v1/chat/completions
KM_LLM_MODEL=deepseek-v4-flash:cloud
KM_LLM_API_KEY=
KM_LLM_TIMEOUT=180
