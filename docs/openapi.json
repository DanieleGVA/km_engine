    "/api/v1/search": {
      "get": {
        "tags": [
          "search"
        ],
        "summary": "Ricerca full-text",
        "description": "Ricerca full-text su label e value dei fatti.\n\n- **Implementazione**: CONTAINS (documentato; per performance usare indici Neo4j full-text)\n- **Filtro visibilit\u00e0**: applicato a tutti i risultati\n- **match_type**: \"entity\" o \"fact\" indica il tipo di match",
        "operationId": "search_endpoint_api_v1_search_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "description": "Testo da cercare",
              "title": "Q"
            },
            "description": "Testo da cercare"
          },
          {
            "name": "label",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filtro per label",
              "title": "Label"
            },
            "description": "Filtro per label"
          },
          {
            "name": "lang",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Lingua risposta (override)",
              "title": "Lang"
            },
            "description": "Lingua risposta (override)"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/AuthSettings"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Settings"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": true
                  },
                  "title": "Response Search Endpoint Api V1 Search Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
