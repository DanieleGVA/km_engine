# ============================================================================
# deploy/.env — ambiente dello stack prod-like (WP7/G8). Copiare da
# .env.example e sostituire TUTTI i segreti prima del primo avvio.
# Mai committare questo file (gitignore: .env).
# ============================================================================

# --- Neo4j (usato da nginx? no: da neo4j service e da backup/restore) ---
NEO4J_AUTH=neo4j/CHANGE_ME_neo4j_password

# --- PostgreSQL ---
POSTGRES_USER=km
POSTGRES_PASSWORD=CHANGE_ME_pg_password
POSTGRES_DB=km_engine

# --- km-api (prefisso KM_, vedi app/auth/config.py) ---
# In prod i servizi si parlano sulla rete interna del compose (nomi servizio)
KM_NEO4J_URI=bolt://neo4j:7687
KM_NEO4J_USER=neo4j
KM_NEO4J_PASSWORD=CHANGE_ME_neo4j_password
KM_PG_DSN=postgresql://km:CHANGE_ME_pg_password@postgres:5432/km_engine
# Secret JWT: generare con `openssl rand -hex 32` (min 32 byte, RFC 7518 3.2)
KM_JWT_SECRET=CHANGE_ME_openssl_rand_hex_32

# --- Bootstrap admin al primo avvio (app/auth/bootstrap.py) ---
KM_ADMIN_USERNAME=admin
KM_ADMIN_PASSWORD=CHANGE_ME_admin_password_min_12_chars

# --- Backup (scripts/backup.sh, scripts/restore.sh) ---
# Passphrase cifratura AES-256 dei backup (NFR7). Generare con
# `openssl rand -base64 32`. In prod: da secret manager o file con permessi 600.
BACKUP_PASSPHRASE=CHANGE_ME_backup_passphrase
